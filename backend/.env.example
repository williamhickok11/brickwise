# Copy to .env locally if you want — never commit real secrets.
# Leave DATABASE_URL unset to use local SQLite (./brickwise.db).
# For real REPS / portfolio data, set DATABASE_URL to your Supabase Postgres URI
# (Cloud Agent / host secrets). Without it the Java API uses SQLite only.

# PORT=8080
# DB_PATH=./brickwise.db

# Supabase / Postgres (required for production REPS data):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:8080/api/v1/integrations/qbo/callback
# QBO_FRONTEND_REDIRECT=http://localhost:5173/settings/quickbooks
# QBO_ENVIRONMENT=sandbox

# Email (REPS CSV export via POST /api/v1/time-entries/export/email)
# Leave MAIL_HOST unset to disable sending; the endpoint returns a clear error until configured.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@yourdomain.com
