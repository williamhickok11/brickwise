# Copy to .env locally if you want — never commit real secrets.
# The server auto-loads .env (or backend/.env) on startup; existing env vars win.
# Leave DATABASE_URL unset to use local SQLite (./brickwise.db).

# PORT=8080
# DB_PATH=./brickwise.db

# Supabase / Postgres (set this to switch off SQLite):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Prefer the "URI" connection string from Supabase:
#   Project Settings → Database → Connection string → URI
# Direct (port 5432) is simplest for this app. Session-mode pooler also works.
# Do not commit real passwords.
